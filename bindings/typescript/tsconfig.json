{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "declaration": true,
    "rootDir": "ts",
    "outDir": "dist",
    "types": [],
    "skipLibCheck": false
  },
  "include": ["ts/**/*.ts"]
}
